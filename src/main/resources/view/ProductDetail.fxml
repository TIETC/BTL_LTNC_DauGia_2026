<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox spacing="15.0" prefWidth="500.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="vn.edu.uet.daugia.client.Controller.ProductDetailController">
    <padding><Insets bottom="25.0" left="25.0" right="25.0" top="25.0" /></padding>

    <Button text="⬅ Quay lại danh sách" onAction="#handleBack" style="-fx-background-color: transparent; -fx-text-fill: #1a0dab; -fx-cursor: hand;"/>

    <Label fx:id="lblName" text="Tên sản phẩm" textFill="#2c3e50">
        <font><Font name="System Bold" size="24.0" /></font>
    </Label>

    <GridPane vgap="10.0" hgap="15.0">
        <Label text="Mã SP:" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-font-weight: bold;"/>
        <Label fx:id="lblId" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

        <Label text="Phiên đấu giá:" GridPane.columnIndex="0" GridPane.rowIndex="1" style="-fx-font-weight: bold;"/>
        <Label fx:id="lblSession" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

        <Label text="Giá khởi điểm:" GridPane.columnIndex="0" GridPane.rowIndex="2" style="-fx-font-weight: bold;"/>
        <Label fx:id="lblStartPrice" textFill="#d35400" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
    </GridPane>

    <Label text="Mô tả chi tiết:" style="-fx-font-weight: bold;"/>
    <TextArea fx:id="txtDescription" wrapText="true" editable="false" prefHeight="120.0"/>

    <HBox alignment="CENTER" spacing="20.0">
        <Button text="Tham gia đấu giá ngay" onAction="#handleJoinAuction" style="-fx-background-color: #28a745; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px;" prefHeight="40.0" prefWidth="200.0"/>
    </HBox>
</VBox>