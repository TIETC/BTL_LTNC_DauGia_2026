<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" prefHeight="550.0" prefWidth="800.0" spacing="15.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="vn.edu.uet.daugia.client.Controller.AuctionListController">
    <children>
        <HBox alignment="TOP_RIGHT" prefWidth="800.0" spacing="15.0">
            <padding>
                <Insets right="20.0" top="15.0" />
            </padding>
            <children>
                <Button mnemonicParsing="false" onAction="#handleSwitchToSeller" style="-fx-background-color: #ffc107; -fx-text-fill: black; -fx-font-weight: bold; -fx-cursor: hand;" text="Giao diện Seller" />
                <Button mnemonicParsing="false" onAction="#handleLogout" style="-fx-background-color: #d9534f; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Đăng xuất" />
            </children>
        </HBox>

        <Label text="DANH SÁCH SẢN PHẨM ĐẤU GIÁ">
            <font>
                <Font name="System Bold" size="24.0" />
            </font>
        </Label>

        <TableView fx:id="tableView" prefHeight="400.0" prefWidth="750.0">
            <columns>
                <TableColumn fx:id="colId" prefWidth="120.0" text="Mã SP" />
                <TableColumn fx:id="colName" prefWidth="250.0" text="Tên sản phẩm" />
                <TableColumn fx:id="colSession" prefWidth="150.0" text="Phiên" />
                <TableColumn fx:id="colStartPrice" prefWidth="200.0" text="Giá khởi điểm (VNĐ)" />
            </columns>
            <VBox.margin>
                <Insets left="25.0" right="25.0" />
            </VBox.margin>
        </TableView>

        <Label text="* Nháy đúp chuột vào sản phẩm để xem chi tiết và đấu giá" textFill="#666666">
            <font>
                <Font name="System Italic" size="13.0" />
            </font>
        </Label>
    </children>
</VBox>