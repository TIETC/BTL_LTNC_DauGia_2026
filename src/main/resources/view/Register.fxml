<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>


<StackPane prefHeight="450.0" prefWidth="650.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="vn.edu.uet.daugia.client.Controller.RegisterController">
    <children>

        <VBox
                alignment="CENTER"
                maxWidth="400.0"
                spacing="15.0"
                style="-fx-background-color: #f4f4f4; -fx-background-radius: 10;">

            <padding>
                <Insets
                        bottom="30.0"
                        left="30.0"
                        right="30.0"
                        top="30.0" />
            </padding>

            <children>

                <Label text="ĐĂNG KÝ TÀI KHOẢN">
                    <font>
                        <Font
                                name="System Bold"
                                size="22.0" />
                    </font>
                </Label>

                <!-- USERNAME -->

                <TextField
                        fx:id="usernameField"
                        promptText="Tên đăng nhập mới"
                        prefHeight="35.0" />

                <!-- PASSWORD -->

                <PasswordField
                        fx:id="passwordField"
                        promptText="Mật khẩu"
                        prefHeight="35.0" />

                <!-- BUTTON -->

                <Button
                        onAction="#onRegisterButtonClick"
                        text="Đăng ký"
                        prefHeight="40.0"
                        prefWidth="150.0"
                        style="-fx-background-color: #28a745; -fx-text-fill: white; -fx-font-weight: bold;" />

                <!-- LINK -->

                <Hyperlink
                        onAction="#switchToLogin"
                        text="Đã có tài khoản? Đăng nhập ngay" />

            </children>

        </VBox>

    </children>

</StackPane>