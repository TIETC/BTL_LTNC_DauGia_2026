<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>

<StackPane prefHeight="450.0" prefWidth="650.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="vn.edu.uet.daugia.client.Controller.RegisterController">
    <children>
        <VBox alignment="CENTER" maxWidth="400.0" spacing="15.0" style="-fx-background-color: #f4f4f4; -fx-background-radius: 10;">
            <padding><Insets bottom="30.0" left="30.0" right="30.0" top="30.0" /></padding>
            <children>
                <Label text="ĐĂNG KÝ TÀI KHOẢN">
                    <font><Font name="System Bold" size="22.0" /></font>
                </Label>

                <TextField fx:id="usernameField" promptText="Tên đăng nhập mới" prefHeight="35.0" />
                <PasswordField fx:id="passwordField" promptText="Mật khẩu" prefHeight="35.0" />

                <Label text="Chọn vai trò của bạn:" />
                <ChoiceBox fx:id="roleChoiceBox" prefWidth="150.0" value="BIDDER">
                    <items>
                        <FXCollections fx:factory="observableArrayList">
                            <String fx:value="BIDDER" />
                            <String fx:value="SELLER" />
                        </FXCollections>
                    </items>
                </ChoiceBox>

                <Button onAction="#onRegisterButtonClick" text="Đăng ký" prefHeight="40.0" prefWidth="150.0" style="-fx-background-color: #28a745; -fx-text-fill: white; -fx-font-weight: bold;" />
                <Hyperlink onAction="#switchToLogin" text="Đã có tài khoản? Đăng nhập ngay" />
            </children>
        </VBox>
    </children>
</StackPane>