<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>

<HBox fx:controller="com.example.login.LoginController"
      stylesheets="@style.css"
      styleClass="root-container"
      prefWidth="900" prefHeight="600"
      xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/17">

    <VBox prefWidth="360" alignment="CENTER_LEFT" styleClass="left-pane" spacing="15">

        <Label text="Welcome Back" styleClass="prestige-title"/>
        <Label text="Truy cập hệ thống đấu giá trực tuyến." styleClass="prestige-subtitle"/>

        <VBox spacing="5">
            <Label text="TÀI KHOẢN" styleClass="input-label"/>
            <TextField fx:id="txtUsername" styleClass="prestige-input"/>
        </VBox>

        <VBox spacing="5">
            <Label text="MẬT KHẨU" styleClass="input-label"/>
            <PasswordField fx:id="txtPassword" styleClass="prestige-input"/>
        </VBox>

        <Region prefHeight="10"/>

        <Button text="ĐĂNG NHẬP" onAction="#onLoginButtonClick" maxWidth="Infinity" styleClass="btn-prestige"/>

        <HBox alignment="CENTER_LEFT" spacing="5" style="-fx-padding: 20 0 0 0;">
            <Label text="Chưa có tài khoản?" styleClass="link-text"/>
            <Label text="Đăng ký ngay" onMouseClicked="#switchToRegister" styleClass="link-action"/>
        </HBox>

    </VBox>

    <StackPane HBox.hgrow="ALWAYS" style="-fx-background-color: #1a1a1a;">
        <ImageView fitWidth="540" fitHeight="600" preserveRatio="false">
            <image>
                <Image url="@background.png"/>
            </image>
        </ImageView>
    </StackPane>

</HBox>