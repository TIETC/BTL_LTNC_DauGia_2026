<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<ScrollPane fitToWidth="true" style="-fx-background-color: white; -fx-padding: 30;"
            stylesheets="@../login/style.css"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.list.SellerController">

    <VBox spacing="25" maxWidth="800">
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Button text="← Thoát (Quay lại danh sách)" onAction="#handleExit" style="-fx-background-color: transparent; -fx-text-fill: #7f8c8d; -fx-cursor: hand; -fx-font-weight: bold;"/>
        </HBox>

        <VBox spacing="5">
            <Label text="Post New Item" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;"/>
            <Label text="STATUS: DRAFT" style="-fx-text-fill: #7f8c8d; -fx-font-size: 12px; -fx-font-weight: bold;"/>
        </VBox>

        <Separator/>

        <HBox spacing="40">
            <VBox spacing="5" HBox.hgrow="ALWAYS">
                <Label text="Tên sản phẩm" styleClass="input-label"/>
                <TextField fx:id="txtItemName" promptText="VD: Đồng hồ Patek Philippe..." styleClass="prestige-input"/>
            </VBox>

            <VBox spacing="5" HBox.hgrow="ALWAYS">
                <Label text="Mã sản phẩm (Viết liền không dấu)" styleClass="input-label"/>
                <TextField fx:id="txtItemId" promptText="VD: SP01" styleClass="prestige-input"/>
            </VBox>
        </HBox>

        <HBox spacing="40">
            <VBox spacing="5" HBox.hgrow="ALWAYS">
                <Label text="Giá khởi điểm (VNĐ)" styleClass="input-label"/>
                <TextField fx:id="txtStartPrice" promptText="VD: 50000000" styleClass="prestige-input"/>
            </VBox>

            <VBox spacing="5" HBox.hgrow="ALWAYS">
                <Label text="Bước giá tối thiểu (VNĐ)" styleClass="input-label"/>
                <TextField fx:id="txtBidIncrement" promptText="Mặc định: 10% Giá khởi điểm" editable="false" styleClass="prestige-input"/>
            </VBox>
        </HBox>

        <HBox spacing="40">
            <VBox spacing="5" HBox.hgrow="ALWAYS">
                <Label text="Thời gian Bắt đầu (Năm-Tháng-Ngày Giờ:Phút:Giây)" styleClass="input-label"/>
                <TextField fx:id="txtStartTime" promptText="VD: 2026-06-10 08:00:00" styleClass="prestige-input"/>
            </VBox>

            <VBox spacing="5" HBox.hgrow="ALWAYS">
                <Label text="Thời gian Kết thúc (Năm-Tháng-Ngày Giờ:Phút:Giây)" styleClass="input-label"/>
                <TextField fx:id="txtEndTime" promptText="VD: 2026-06-15 20:00:00" styleClass="prestige-input"/>
            </VBox>
        </HBox>

        <VBox spacing="5">
            <Label text="Hình ảnh sản phẩm" styleClass="input-label"/>
            <HBox spacing="15" alignment="CENTER_LEFT">
                <Button text="Tải ảnh lên (Upload)" onAction="#handleChooseImage" style="-fx-background-color: #ecf0f1; -fx-text-fill: #2c3e50; -fx-cursor: hand;"/>
                <Label fx:id="lblImagePath" text="Chưa có ảnh nào được chọn" style="-fx-text-fill: #e74c3c; -fx-font-style: italic;"/>
            </HBox>
        </VBox>

        <VBox spacing="5">
            <Label text="Mô tả chi tiết" styleClass="input-label"/>
            <TextArea fx:id="txtDescription" prefHeight="100" promptText="Tình trạng, nguồn gốc, xuất xứ..." style="-fx-border-color: #dcdde1; -fx-background-color: transparent;"/>
        </VBox>

        <HBox alignment="CENTER_RIGHT" style="-fx-padding: 20 0 0 0;">
            <Button text="POST AUCTION" onAction="#handlePostItem" styleClass="btn-prestige" style="-fx-padding: 12 40 12 40;"/>
        </HBox>
    </VBox>
</ScrollPane>