<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane style="-fx-background-color: #f4f4f4;"
            stylesheets="@../login/style.css"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.list.AuctionGridController">

    <top>
        <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-background-color: white; -fx-padding: 12 25; -fx-border-color: #e0e0e0; -fx-border-width: 0 0 1 0;">
            <Label text="Trạng thái phiên:" style="-fx-font-weight: bold; -fx-text-fill: #555;"/>
            <Button text="Tất cả" fx:id="btnAll" onAction="#handleFilterAll" style="-fx-background-color: #c8a97e; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
            <Button text="Chưa đấu giá" fx:id="btnPending" onAction="#handleFilterPending" style="-fx-background-color: #f5f5f5; -fx-text-fill: #555; -fx-cursor: hand;"/>
            <Button text="Đang diễn ra" fx:id="btnRunning" onAction="#handleFilterRunning" style="-fx-background-color: #f5f5f5; -fx-text-fill: #555; -fx-cursor: hand;"/>
            <Button text="Đã kết thúc" fx:id="btnFinished" onAction="#handleFilterFinished" style="-fx-background-color: #f5f5f5; -fx-text-fill: #555; -fx-cursor: hand;"/>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-padding: 10;">
            <FlowPane fx:id="productGrid" hgap="25" vgap="25" alignment="TOP_LEFT" style="-fx-padding: 10;"/>
        </ScrollPane>
    </center>

    <bottom>
        <HBox fx:id="sellerActionBar" alignment="CENTER_RIGHT" spacing="15" style="-fx-background-color: white; -fx-padding: 15 30; -fx-border-color: #e0e0e0; -fx-border-width: 1 0 0 0;">
            <Label text="Kênh quản lý dành cho thành viên Người Bán:" style="-fx-text-fill: #7f8c8d; -fx-font-style: italic;"/>
            <Button text="+ TẠO SẢN PHẨM MỚI" onAction="#goToPostPage" styleClass="btn-prestige" style="-fx-padding: 10 25;"/>
        </HBox>
    </bottom>
</BorderPane>