<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane fx:controller="com.example.list.MainDashboardController"
            stylesheets="@../login/style.css"
            prefWidth="1200" prefHeight="800"
            styleClass="root-container"
            xmlns:fx="http://javafx.com/fxml/1">
    <top>
        <HBox alignment="CENTER_RIGHT" style="-fx-background-color: white; -fx-padding: 15 30; -fx-border-color: #e0e0e0; -fx-border-width: 0 0 1 0;">
            <Label text="⏱ GLOBAL EXCHANGE ACTIVE   |   " style="-fx-text-fill: #7f8c8d; -fx-font-size: 12px; -fx-font-weight: bold;"/>
            <Label fx:id="lblClock" text="12:00:00" style="-fx-text-fill: #1a1a1a; -fx-font-size: 18px; -fx-font-weight: bold; -fx-font-family: 'Consolas';"/>
        </HBox>
    </top>

    <left>
        <VBox prefWidth="250" styleClass="sidebar" spacing="30">
            <VBox spacing="5" alignment="CENTER_LEFT" style="-fx-padding: 0 0 10 10;">
                <Label text="The Prestige Exchange" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;"/>
            </VBox>

            <VBox spacing="5" VBox.vgrow="ALWAYS">
                <Button text="■  Auction List" fx:id="btnAuctionList" onAction="#handleMenuAuctionList" maxWidth="Infinity" styleClass="nav-btn, nav-btn-active"/>
                <Button text="📦  Sản phẩm của tôi" fx:id="btnMyItems" onAction="#handleMenuMyItems" maxWidth="Infinity" styleClass="nav-btn" visible="false" managed="false"/>
                <Button text="👤  Profile" fx:id="btnProfile" onAction="#showProfile" maxWidth="Infinity" styleClass="nav-btn"/>
            </VBox>

            <VBox styleClass="user-info-box" spacing="10">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="👤" style="-fx-font-size: 24px;"/>
                    <VBox alignment="CENTER_LEFT">
                        <Label fx:id="lblUsername" text="Người dùng" style="-fx-font-weight: bold; -fx-text-fill: #1a1a1a;"/>
                    </VBox>
                </HBox>
                <Label text="SỐ DƯ TÀI KHOẢN" style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #7f8c8d;"/>
                <Label text="0 VNĐ" style="-fx-font-weight: bold; -fx-font-size: 16px; -fx-text-fill: #c8a97e;"/>
                <Button text="Logout" onAction="#handleLogout" maxWidth="Infinity" style="-fx-background-color: transparent; -fx-text-fill: #e74c3c; -fx-cursor: hand; -fx-font-weight: bold; -fx-border-color: #e74c3c; -fx-border-radius: 5;"/>
            </VBox>
        </VBox>
    </left>
    <center>
        <StackPane fx:id="contentArea" style="-fx-background-color: white; -fx-padding: 20;">
            <Label text="Đang tải dữ liệu..." style="-fx-text-fill: #7f8c8d;"/>
        </StackPane>
    </center>

</BorderPane>