<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="20.0" prefHeight="550.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.list.AuctionController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label text="DANH SÁCH ĐẤU GIÁ">
        <font>
            <Font name="System Bold" size="24.0" />
        </font>
    </Label>

    <TableView fx:id="productTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colName" prefWidth="300.0" text="Tên sản phẩm" />
            <TableColumn fx:id="colPrice" prefWidth="250.0" text="Giá khởi điểm" />
        </columns>
    </TableView>

    <HBox alignment="CENTER" spacing="10.0">
        <children>
            <TextField fx:id="txtName" promptText="Nhập tên sản phẩm..." prefWidth="200.0" />
            <TextField fx:id="txtPrice" promptText="Nhập giá (VD: 500.000)" prefWidth="150.0" />
            <Button onAction="#onAddClick" text="+" style="-fx-background-color: #28a745; -fx-text-fill: white; -fx-font-weight: bold;" />
            <Button onAction="#onDeleteClick" text="Xóa" style="-fx-background-color: #dc3545; -fx-text-fill: white;" />
        </children>
    </HBox>
</VBox>