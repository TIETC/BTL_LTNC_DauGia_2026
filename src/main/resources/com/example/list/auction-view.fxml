<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.list.AuctionController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label text="DANH SÁCH SẢN PHẨM ĐẤU GIÁ">
        <font><Font name="System Bold" size="20.0" /></font>
    </Label>

    <TableView fx:id="productTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" prefWidth="70.0" text="Mã SP" />
            <TableColumn fx:id="colName" prefWidth="180.0" text="Tên sản phẩm" />
            <TableColumn fx:id="colSession" prefWidth="100.0" text="Phiên" />
            <TableColumn fx:id="colPrice" prefWidth="150.0" text="Giá khởi điểm" />
        </columns>
    </TableView>
</VBox>