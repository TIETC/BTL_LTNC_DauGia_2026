<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>

<HBox fx:controller="vn.edu.uet.daugia.client.ui.login.RegisterController"
      stylesheets="@style.css"
      styleClass="root-container"
      prefWidth="900" prefHeight="600"
      xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/17">

    <VBox prefWidth="400" alignment="CENTER_LEFT" styleClass="left-pane" spacing="12">

        <Label text="Create Account" styleClass="prestige-title"/>
        <Label text="Please enter your details to register for the platform." styleClass="prestige-subtitle"/>

        <VBox spacing="5">
            <Label text="USERNAME / EMAIL" styleClass="input-label"/>
            <TextField fx:id="usernameField" promptText="Unique username" styleClass="prestige-input"/>
        </VBox>

        <VBox spacing="5">
            <Label text="PASSWORD" styleClass="input-label"/>
            <PasswordField fx:id="passwordField" promptText="********" styleClass="prestige-input"/>
        </VBox>

        <VBox spacing="8" style="-fx-padding: 10 0 10 0;">
            <Label text="SELECT ROLE" styleClass="input-label"/>
            <HBox spacing="20">
                <fx:define>
                    <ToggleGroup fx:id="roleGroup"/>
                </fx:define>
                <RadioButton fx:id="radioBuyer" text="Buyer (Người mua)" toggleGroup="$roleGroup" selected="true" style="-fx-text-fill: #2c3e50; -fx-font-weight: bold;"/>
                <RadioButton fx:id="radioSeller" text="Seller (Người bán)" toggleGroup="$roleGroup" style="-fx-text-fill: #2c3e50; -fx-font-weight: bold;"/>
            </HBox>
        </VBox>

        <Button text="SIGN UP" onAction="#onRegisterButtonClick" maxWidth="Infinity" styleClass="btn-prestige"/>

        <HBox alignment="CENTER_LEFT" spacing="5" style="-fx-padding: 10 0 0 0;">
            <Label text="Already have an account?" styleClass="link-text"/>
            <Label text="Login" onMouseClicked="#switchToLogin" styleClass="link-action"/>
        </HBox>

    </VBox>

    <StackPane HBox.hgrow="ALWAYS" style="-fx-background-color: #1a1a1a;">
        <ImageView fitWidth="500" fitHeight="600" preserveRatio="false">
            <image>
                <Image url="@background.png"/>
            </image>
        </ImageView>
    </StackPane>

</HBox>