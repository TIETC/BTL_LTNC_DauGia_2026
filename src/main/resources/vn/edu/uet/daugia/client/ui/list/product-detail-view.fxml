<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<VBox spacing="20.0" prefWidth="850.0" prefHeight="550.0"
      stylesheets="@../login/style.css" style="-fx-background-color: white; -fx-padding: 30;"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="vn.edu.uet.daugia.client.ui.list.ProductDetailController">

    <HBox alignment="CENTER_LEFT" spacing="10">
        <Button text="← Quay lại Sàn Đấu Giá" onAction="#handleBackToList" style="-fx-background-color: transparent; -fx-text-fill: #7f8c8d; -fx-cursor: hand; -fx-font-weight: bold; -fx-font-size: 14px;"/>
    </HBox>

    <HBox spacing="40.0" VBox.vgrow="ALWAYS">
        <VBox alignment="CENTER" prefWidth="350.0" style="-fx-background-color: #f8f9fa; -fx-background-radius: 12; -fx-border-color: #e0e0e0; -fx-border-radius: 12; -fx-padding: 10;">
            <ImageView fx:id="imgProduct" fitWidth="330.0" fitHeight="330.0" preserveRatio="true"/>
        </VBox>

        <VBox spacing="15.0" HBox.hgrow="ALWAYS">
            <Label fx:id="lblProductName" text="Tên sản phẩm" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;" wrapText="true"/>

            <GridPane vgap="12" hgap="15">
                <Label text="Mã SP:" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-text-fill: #7f8c8d; -fx-font-weight: bold;"/>
                <Label fx:id="lblProductId" text="--" GridPane.columnIndex="1" GridPane.rowIndex="0" style="-fx-font-weight: bold; -fx-text-fill: #1a1a1a;"/>

                <Label text="Bắt đầu:" GridPane.columnIndex="0" GridPane.rowIndex="1" style="-fx-text-fill: #7f8c8d; -fx-font-weight: bold;"/>
                <Label fx:id="lblStartTime" text="--" GridPane.columnIndex="1" GridPane.rowIndex="1" style="-fx-text-fill: #1a1a1a;"/>

                <Label text="Kết thúc:" GridPane.columnIndex="0" GridPane.rowIndex="2" style="-fx-text-fill: #7f8c8d; -fx-font-weight: bold;"/>
                <Label fx:id="lblEndTime" text="--" GridPane.columnIndex="1" GridPane.rowIndex="2" style="-fx-text-fill: #1a1a1a;"/>

                <Label text="Mô tả:" GridPane.columnIndex="0" GridPane.rowIndex="3" style="-fx-text-fill: #7f8c8d; -fx-font-weight: bold;"/>
                <Label fx:id="lblDescription" text="--" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="3" style="-fx-text-fill: #1a1a1a;"/>
            </GridPane>

            <Separator />

            <VBox spacing="15.0" style="-fx-background-color: #fafafa; -fx-padding: 20; -fx-background-radius: 8; -fx-border-color: #c8a97e; -fx-border-radius: 8; -fx-border-width: 2;">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="💰 GIÁ HIỆN TẠI:" style="-fx-font-weight: bold; -fx-text-fill: #7f8c8d; -fx-font-size: 14px;"/>
                    <Label fx:id="lblCurrentPrice" text="0 VNĐ" style="-fx-text-fill: #1a1a1a; -fx-font-size: 28px; -fx-font-weight: bold;"/>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="⏱ THỜI GIAN CÒN LẠI:" style="-fx-font-weight: bold; -fx-text-fill: #7f8c8d; -fx-font-size: 14px;"/>
                    <Label fx:id="lblTimer" text="00:00:00" style="-fx-text-fill: #e74c3c; -fx-font-size: 22px; -fx-font-weight: bold;"/>
                </HBox>
            </VBox>

            <HBox spacing="15.0" alignment="CENTER_LEFT" style="-fx-padding: 10 0 0 0;">
                <TextField fx:id="txtBidAmount" promptText="Nhập số tiền muốn đấu..." styleClass="prestige-input" HBox.hgrow="ALWAYS" style="-fx-font-size: 16px; -fx-padding: 10;"/>
                <Button fx:id="btnPlaceBid" text="ĐẶT GIÁ NGAY" onAction="#handlePlaceBid" styleClass="btn-prestige" style="-fx-padding: 12 30; -fx-font-size: 16px;"/>
            </HBox>
        </VBox>
    </HBox>
</VBox>